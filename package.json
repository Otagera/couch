{
  "name": "my-movies-cli",
  "version": "1.0.0",
  "description": "A CLI tool for Letterboxd movie recommendations and watchlist management.",
  "main": "dist/index.js",
  "bin": {
    "my-movies-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED='0' ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "npx @biomejs/biome format --write ./src",
    "lint": "npx @biomejs/biome lint ./src",
    "check": "npx @biomejs/biome check ./src",
    "build": "tsc && node -e \"const fs=require('fs'); const p='dist/index.js'; let c=fs.readFileSync(p,'utf8'); if(!c.startsWith('#!')){fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c); fs.chmodSync(p,'755');}\"",
    "simkl": "ts-node src/simkl-cli.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/node": "^24.19.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "chromadb": "^3.5.0",
    "cli-spinners": "^2.9.2",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "inquirer": "^9.3.8",
    "knex": "^3.3.0",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/inquirer": "^9.0.10"
  }
}
