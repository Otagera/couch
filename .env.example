# Couch configuration. Locally: copy to .env. Under Coolify: set these in the
# resource's Environment Variables tab. Never commit .env.

# --- Simkl (TV library) ----------------------------------------------------
# Create an app at https://simkl.com/settings/developer/ with type
# "TV / devices / CLI", then connect with `npm run cli -- login` or the UI.
SIMKL_CLIENT_ID=

# --- TMDB (metadata, posters, where to watch) ------------------------------
TMDB_API_KEY=
STREAMING_COUNTRY_CODE=NG
# Comma-separated TMDB provider names you subscribe to.
STREAMING_SERVICES=Netflix, Amazon Prime Video

# --- OpenRouter (taste profile + picks) ------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_PICK_MODEL=openai/gpt-5.6-luna      # try anthropic/claude-sonnet-5.5 to compare
# OPENROUTER_PROFILE_MODEL=anthropic/claude-haiku-5.5

# --- Chatterbox (logs) -------------------------------------------------------
# Leave the app name or secret empty to log to the console only.
CHATTERBOX_API_URL=https://chatterbox.otagera.xyz
CHATTERBOX_APP_NAME=
CHATTERBOX_API_SECRET=
# COUCH_LOG_LEVEL=warn   # console level: debug | info | warn | error

# --- Storage -----------------------------------------------------------------
# COUCH_DB_PATH=.data/couch.db
# Folder with your Letterboxd export (ratings.csv, reviews.csv).
# COUCH_LETTERBOXD_DIR=data
# COUCH_STALLED_DAYS=42

# --- Sign-in (passkeys) ------------------------------------------------------
# Required when deployed; unset = no sign-in (local development only).
# A long random string. It is only used to register the first passkey (and
# again after `cli passkeys reset`); after that, sign-in is passkey-only.
COUCH_SETUP_CODE=
# The public URL passkeys are bound to. Unset locally (uses the request's own).
# COUCH_ORIGIN=https://couch.otagera.xyz

# COUCH_LIST_REFRESH_DAYS=7   # how often followed Letterboxd lists are re-read
